# ========================================
# RVCS Service Dockerfile (Production Build)
# Includes Web Frontend
# ========================================

# Build stage for Web frontend
FROM node:20-alpine AS web-builder

WORKDIR /build/web

# Copy package files
COPY web/package*.json ./
COPY web/vite.config.ts ./
COPY web/tsconfig.json ./

# Install dependencies
RUN npm ci --only=production

# Copy web source
COPY web/ ./

# Build web
RUN npm run build

# Build stage for Go service
FROM golang:1.21-alpine AS go-builder

WORKDIR /build/service

# Install build dependencies
RUN apk add --no-cache git gcc musl-dev

# Copy go.mod and go.sum
COPY service/go.mod service/go.sum ./

# Download dependencies
RUN go mod download

# Copy service source
COPY service/ ./

# Build service
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o rvcs-server ./cmd/server

# Final runtime stage
FROM alpine:latest

# Install runtime dependencies
RUN apk --no-cache add ca-certificates tzdata

# Set timezone
ENV TZ=Asia/Shanghai

WORKDIR /app

# Copy service binary from builder
COPY --from=go-builder /build/service/rvcs-server .

# Copy web static files from web-builder
COPY --from=web-builder /build/web/dist ./web

# Copy config files
COPY service/configs/ ./configs/

# Create non-root user
RUN addgroup -g 1000 rvcs && \
    adduser -D -u 1000 -G rvcs rvcs && \
    chown -R rvcs:rvcs /app

USER rvcs

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

# Run service
CMD ["./rvcs-server"]
