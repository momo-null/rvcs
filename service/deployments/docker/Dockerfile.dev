# ========================================
# RVCS Service Development Dockerfile
# ========================================

FROM golang:1.21-alpine

WORKDIR /app

# Install Air for hot reload
RUN go install github.com/cosmtrek/air@latest

# Copy go modules
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Build with Air for hot reload
RUN go build -o rvcs-server ./cmd/server

# Expose port
EXPOSE 8080

# Run with Air for hot reload
CMD ["air"]
